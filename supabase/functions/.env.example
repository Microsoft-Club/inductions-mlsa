# Local secrets for `npm run functions:serve`. Copy this file to supabase/functions/.env (git-ignored),
# which the local edge runtime loads automatically. Production secrets are set in the Supabase
# dashboard (Edge Functions → Secrets) instead; never reuse this value there.

# form-sync: the shared secret the Google Form's Apps Script sends (see docs/google-form-sync.md).
FORM_SYNC_SECRET=local-form-sync-secret
